{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "line-ai-scheduler",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },

  // ── 定期掃除（古いpending/会話履歴の削除）─────────────────────────
  "triggers": {
    "crons": ["0 * * * *"] // 毎時0分
  },

  // ── D1: 会話履歴のコンテキスト保持用（ステップ4で利用） ───────────────
  // 作成: `wrangler d1 create line-ai-scheduler`
  // 出てきた database_id を下に貼る。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "line-ai-scheduler",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],

  // ── 非機密の環境変数 ────────────────────────────────────────────────
  // 機密情報（CHANNEL_SECRET / ACCESS_TOKEN / APIキー）は vars に書かず、
  // `wrangler secret put` で登録する（下記 .dev.vars.example 参照）。
  "vars": {
    "APP_TIMEZONE": "Asia/Tokyo",
    "ANTHROPIC_MODEL": "claude-opus-4-8",
    // 空き時間を提示する際の稼働時間帯（この範囲内の隙間だけを「空き」とする）
    "WORK_START_HOUR": "9",
    "WORK_END_HOUR": "21"
  }
}
